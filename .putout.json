{
    "plugins": ["printer"],
    "rules": {
        "type-checker": "on",
        "github/convert-npm-to-bun": "off",
        "putout/apply-lowercase-to-node-builders": "on",
        "putout/remove-useless-source-argument": "on"
    },
    "match": {
        "type-checker.spec.js": {
            "type-checker": "off"
        },
        "*.md": {
            "printer/remove-args": "off"
        },
        "{test,debug.js}": {
            "remove-console": "off",
            "variables/remove-unused": "off",
            "variables/remove-useless": "off"
        },
        "test": {
            "type-checker/check-type-passed-to-type-checker": "off",
            "type-checker/check-if-success-possible-in-type-checke": "off"
        },
        "*.ts": {
            "esm": "off"
        }
    }
}
